// OAuth developer credentials for the Vanmo and Vanmo-macOS targets.
//
// Every value is empty in git. Real values live in the untracked `Local.xcconfig`
// at the repository root (copy `Local.xcconfig.example`). An empty value keeps the
// matching sign-in control disabled.
//
// xcconfig treats `//` as a comment and expands `$(...)`, so a value must not contain them.

VANMO_GOOGLE_DRIVE_CLIENT_PREFIX =
VANMO_GOOGLE_DRIVE_CLIENT_ID =
VANMO_GOOGLE_DRIVE_URL_SCHEME =
VANMO_ONEDRIVE_CLIENT_ID =
VANMO_BOX_CLIENT_ID =
VANMO_BOX_CLIENT_SECRET =
VANMO_PCLOUD_CLIENT_ID =
VANMO_PCLOUD_CLIENT_SECRET =
VANMO_YANDEX_DISK_CLIENT_ID =
VANMO_BAIDU_NETDISK_APP_KEY =

#include? "../Local.xcconfig"
