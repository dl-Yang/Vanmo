// Copy to `Local.xcconfig` (git-ignored) and fill in the credentials for this machine.
// `Config/Secrets.xcconfig` includes this file at build time; no project regeneration is needed.
// Values must not contain `//` (comment marker) or `$` (variable expansion).
// Release / Archive builds need this file, or every OAuth sign-in ships disabled.

// Google Drive iOS OAuth client (PKCE, no secret). Fill only the prefix before
// `.apps.googleusercontent.com`, then uncomment the two derived lines so the client ID
// and the reversed URL scheme always match.
VANMO_GOOGLE_DRIVE_CLIENT_PREFIX =
// VANMO_GOOGLE_DRIVE_CLIENT_ID = $(VANMO_GOOGLE_DRIVE_CLIENT_PREFIX).apps.googleusercontent.com
// VANMO_GOOGLE_DRIVE_URL_SCHEME = com.googleusercontent.apps.$(VANMO_GOOGLE_DRIVE_CLIENT_PREFIX)

// Microsoft Entra public client (PKCE, no secret).
VANMO_ONEDRIVE_CLIENT_ID =

// Box Custom App. Box has no PKCE, so both values are required.
VANMO_BOX_CLIENT_ID =
VANMO_BOX_CLIENT_SECRET =

// pCloud app. Both values are required.
VANMO_PCLOUD_CLIENT_ID =
VANMO_PCLOUD_CLIENT_SECRET =

// Yandex OAuth app (no secret). Also drives the iOS `yx<id>` URL scheme and associated domain.
VANMO_YANDEX_DISK_CLIENT_ID =

// Baidu Netdisk AppKey (implicit grant, no secret).
VANMO_BAIDU_NETDISK_APP_KEY =
